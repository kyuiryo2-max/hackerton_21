{
  "_설명": "정류소 도착 정보. 분은 늦지 않게 내림. 실시간(demo=false)은 아직 501",
  "examples": [
    {
      "request": {
        "method": "GET",
        "path": "/api/arrivals",
        "query": {
          "stop_id": "08301",
          "demo": "true"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "arrivals": [
            {
              "route": "2115",
              "minutes": 12,
              "next_minutes": 20,
              "direction": "중랑공영차고지"
            },
            {
              "route": "273",
              "minutes": 3,
              "next_minutes": 10,
              "direction": "중랑공영차고지"
            }
          ]
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/arrivals",
        "query": {
          "stop_id": "08301",
          "demo": "true",
          "elapsed_seconds": 600
        }
      },
      "response": {
        "status": 200,
        "body": {
          "arrivals": [
            {
              "route": "2115",
              "minutes": 2,
              "next_minutes": 10,
              "direction": "중랑공영차고지"
            },
            {
              "route": "273",
              "minutes": 0,
              "next_minutes": null,
              "direction": "중랑공영차고지"
            }
          ]
        }
      },
      "note": "10분 지난 장면. 지나간 차는 빠지고 다음 차가 첫 차"
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/arrivals",
        "query": {
          "stop_id": "08301"
        }
      },
      "response": {
        "status": 501,
        "body": {
          "error": {
            "code": "not_ready",
            "message": "실시간 도착은 아직 연결되지 않았어요"
          }
        }
      }
    }
  ]
}
