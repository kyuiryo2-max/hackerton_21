# 이 파일을 복사해서 .env 를 만들고 값을 채우세요.  (cp .env.example .env)
# .env 는 .gitignore 에 들어 있어서 GitHub에 올라가지 않아요.

# LLM (OpenRouter, OpenAI 호환)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=

# 공공데이터포털 (버스 도착 정보 등)
DATA_GO_KR_SERVICE_KEY=

# 서울 열린데이터광장 (지하철 실시간 도착 정보)
SEOUL_OPEN_API_KEY=

# 카카오 로컬 (주소→좌표, 장소 검색)
KAKAO_REST_API_KEY=

# TMAP (도보 경로)
TMAP_APP_KEY=

# 서버 설정
DATABASE_PATH=teumgil.db
SEED_DEMO_DATA=true
