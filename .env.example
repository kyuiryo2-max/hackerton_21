# 이 파일을 복사해서 .env 를 만들고 값을 채우세요.  (cp .env.example .env)
# .env 는 .gitignore 에 들어 있어서 GitHub에 올라가지 않아요.

# LLM (Meta Model API, OpenAI 호환. 다른 OpenAI 호환 서버로 바꿔도 됩니다)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.meta.ai/v1
LLM_MODEL=muse-spark-1.3-contributor
# 프롬프트 버전 (v1 | v2 | v3). 기본 v2
LLM_PROMPT_VERSION=v2
# AI 응답 대기 시간(초). 기본 5초. reasoning 모델(Muse Spark 등)은 늘려야 응답을 받아요
LLM_TIMEOUT_SECONDS=5
# reasoning 모델의 사고량 (minimal | low | medium | high). 비우면 모델 기본값
LLM_REASONING_EFFORT=
# 샘플링 온도. 비우면 모델 기본값 (Muse Spark는 1.0 권장)
LLM_TEMPERATURE=

# 공공데이터포털 (버스 도착 정보 등)
DATA_GO_KR_SERVICE_KEY=

# 서울 열린데이터광장 (지하철 실시간 도착 정보)
SEOUL_OPEN_API_KEY=

# 카카오맵 (주소→좌표, 장소 검색, 대중교통·도보 경로)
KAKAO_REST_API_KEY=

# 서버 설정
DATABASE_PATH=teumgil.db
SEED_DEMO_DATA=true
